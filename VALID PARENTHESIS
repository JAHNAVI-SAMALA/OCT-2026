class Solution:
    def isValid(self, s: str) -> bool:
        stack = []

        for c in s:
            if c in "([{":
                stack.append(c)
            else:
                if not stack:
                    return False

                x = stack.pop()

                if (c == ')' and x != '(') or \
                   (c == ']' and x != '[') or \
                   (c == '}' and x != '{'):
                    return False

        return len(stack) == 0
