
class Solution:
    def minSumSquareDiff(self, nums1: List[int], nums2: List[int], k1: int, k2: int) -> int:
        diff = [abs(a - b) for a, b in zip(nums1, nums2)]
        k = k1 + k2

        if sum(diff) <= k:
            return 0

        l, r = 0, max(diff)

        while l < r:
            mid = (l + r) // 2
            need = sum(max(0, x - mid) for x in diff)

            if need <= k:
                r = mid
            else:
                l = mid + 1

        ans = 0
        remaining = k

        for x in diff:
            if x > l:
                remaining -= x - l
                x = l
            ans += x * x

        
        ans -= remaining * (2 * l - 1)

        return ans
